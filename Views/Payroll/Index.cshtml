@model IEnumerable<WebApplicationFES.Models.Payroll>

<div class="container-fluid">
    <h2>Payroll</h2>
    <p>
        <a asp-action="Create" class="btn btn-primary">Create New</a>
    </p>

    <div class="table-responsive">
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>@Html.DisplayNameFor(model => model.User.FirstName)</th>
                    <th>@Html.DisplayNameFor(model => model.PayPeriodStart)</th>
                    <th>@Html.DisplayNameFor(model => model.PayPeriodEnd)</th>
                    <th>@Html.DisplayNameFor(model => model.BaseSalary)</th>
                    <th>@Html.DisplayNameFor(model => model.NetSalary)</th>
                    <th>@Html.DisplayNameFor(model => model.Status)</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@Html.DisplayFor(modelItem => item.User.FirstName)</td>
                        <td>@Html.DisplayFor(modelItem => item.PayPeriodStart)</td>
                        <td>@Html.DisplayFor(modelItem => item.PayPeriodEnd)</td>
                        <td>@Html.DisplayFor(modelItem => item.BaseSalary)</td>
                        <td>@Html.DisplayFor(modelItem => item.NetSalary)</td>
                        <td>@Html.DisplayFor(modelItem => item.Status)</td>
                        <td>
                            <a asp-action="Edit" asp-route-id="@item.PayrollId" class="btn btn-sm btn-primary">Edit</a>
                            <a asp-action="Details" asp-route-id="@item.PayrollId" class="btn btn-sm btn-info">Details</a>
                            <a asp-action="Delete" asp-route-id="@item.PayrollId" class="btn btn-sm btn-danger">Delete</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div> 