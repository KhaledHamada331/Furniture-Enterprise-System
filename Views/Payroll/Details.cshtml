@model WebApplicationFES.Models.Payroll

<div class="container mt-4">
    <h2>Payroll Details</h2>
    <dl class="row">
        <dt class="col-sm-2">User</dt>
        <dd class="col-sm-10">@Model.User?.FirstName</dd>
        <dt class="col-sm-2">Pay Period Start</dt>
        <dd class="col-sm-10">@Model.PayPeriodStart.ToShortDateString()</dd>
        <dt class="col-sm-2">Pay Period End</dt>
        <dd class="col-sm-10">@Model.PayPeriodEnd.ToShortDateString()</dd>
        <dt class="col-sm-2">Base Salary</dt>
        <dd class="col-sm-10">@Model.BaseSalary</dd>
        <dt class="col-sm-2">Overtime Pay</dt>
        <dd class="col-sm-10">@Model.OvertimePay</dd>
        <dt class="col-sm-2">Bonuses</dt>
        <dd class="col-sm-10">@Model.Bonuses</dd>
        <dt class="col-sm-2">Deductions</dt>
        <dd class="col-sm-10">@Model.Deductions</dd>
        <dt class="col-sm-2">Net Salary</dt>
        <dd class="col-sm-10">@Model.NetSalary</dd>
        <dt class="col-sm-2">Status</dt>
        <dd class="col-sm-10">@Model.Status</dd>
        <dt class="col-sm-2">Payment Date</dt>
        <dd class="col-sm-10">@Model.PaymentDate?.ToShortDateString()</dd>
        <dt class="col-sm-2">Payment Method</dt>
        <dd class="col-sm-10">@Model.PaymentMethod</dd>
        <dt class="col-sm-2">Notes</dt>
        <dd class="col-sm-10">@Model.Notes</dd>
    </dl>
    <a asp-action="Edit" asp-route-id="@Model.PayrollId" class="btn btn-primary">Edit</a>
    <a asp-action="Index" class="btn btn-secondary">Back to List</a>
</div> 