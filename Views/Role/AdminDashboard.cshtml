@{
    ViewData["Title"] = "Admin Dashboard";
}
<div class="container py-4">
    <h2 class="mb-4">Admin Dashboard</h2>
    <div class="row g-4">
        <div class="col-md-3">
            <a href="/User" class="card text-center shadow-sm p-4 text-decoration-none">
                <i class="bi bi-people display-4 text-primary"></i>
                <h5 class="mt-2">Users</h5>
            </a>
        </div>
        <div class="col-md-3">
            <a href="/Product" class="card text-center shadow-sm p-4 text-decoration-none">
                <i class="bi bi-box-seam display-4 text-warning"></i>
                <h5 class="mt-2">Products</h5>
            </a>
        </div>
        <div class="col-md-3">
            <a href="/Supplier" class="card text-center shadow-sm p-4 text-decoration-none">
                <i class="bi bi-shop display-4 text-success"></i>
                <h5 class="mt-2">Suppliers</h5>
            </a>
        </div>
        <div class="col-md-3">
            <a href="/Purchase" class="card text-center shadow-sm p-4 text-decoration-none">
                <i class="bi bi-cart-plus display-4 text-info"></i>
                <h5 class="mt-2">Purchases</h5>
            </a>
        </div>
        <div class="col-md-3">
            <a href="/Sale" class="card text-center shadow-sm p-4 text-decoration-none">
                <i class="bi bi-cash-stack display-4 text-danger"></i>
                <h5 class="mt-2">Sales</h5>
            </a>
        </div>
        <div class="col-md-3">
            <a href="/Expense" class="card text-center shadow-sm p-4 text-decoration-none">
                <i class="bi bi-receipt display-4 text-secondary"></i>
                <h5 class="mt-2">Expenses</h5>
            </a>
        </div>
        <div class="col-md-3">
            <a href="/Payroll" class="card text-center shadow-sm p-4 text-decoration-none">
                <i class="bi bi-currency-dollar display-4 text-dark"></i>
                <h5 class="mt-2">Payroll</h5>
            </a>
        </div>
    </div>
</div> 