@{
    ViewData["Title"] = "Accountant Dashboard";
}
<div class="container py-4">
    <h2 class="mb-4">Accountant Dashboard</h2>
    <div class="row g-4">
        <div class="col-md-4">
            <a href="/Expense" class="card text-center shadow-sm p-4 text-decoration-none">
                <i class="bi bi-receipt display-4 text-secondary"></i>
