@model WebApplicationFES.Models.Sale

@{
    ViewData["Title"] = "Delete Sale";
}

<div class="container-fluid p-4">
    <div class="row">
        <div class="col-md-8 offset-md-2">
            <div class="card">
                <div class="card-header bg-danger text-white">
                    <h3 class="card-title">Delete Sale</h3>
                </div>
                <div class="card-body">
                    <h4>Are you sure you want to delete this sale?</h4>
                    <hr />
                    <dl class="row">
                        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.SaleId)</dt>
                        <dd class="col-sm-9">@Html.DisplayFor(model => model.SaleId)</dd>

                        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.CustomerName)</dt>
                        <dd class="col-sm-9">@Html.DisplayFor(model => model.CustomerName)</dd>

                        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.SaleDate)</dt>
                        <dd class="col-sm-9">@Html.DisplayFor(model => model.SaleDate)</dd>

                        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.TotalAmount)</dt>
                        <dd class="col-sm-9">@Html.DisplayFor(model => model.TotalAmount)</dd>

                        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Status)</dt>
                        <dd class="col-sm-9">
                            <span class="badge @(Model.Status == "Completed" ? "bg-success" : "bg-warning")">
                                @Html.DisplayFor(model => model.Status)
                            </span>
                        </dd>
                    </dl>

                    <form asp-action="Delete" class="mt-3">
                        <input type="hidden" asp-for="SaleId" />
                        <div class="form-group">
                            <a asp-action="Index" class="btn btn-secondary">Back to List</a>
                            <button type="submit" class="btn btn-danger">Delete</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div> 