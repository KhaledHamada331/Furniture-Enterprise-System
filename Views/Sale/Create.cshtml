@model WebApplicationFES.Models.Sale

@{
    ViewData["Title"] = "Create Sale";
}

<div class="container-fluid p-4">
    <div class="row">
        <div class="col-md-8 offset-md-2">
            <div class="card">
                <div class="card-header">
                    <h3 class="card-title">Create New Sale</h3>
                </div>
                <div class="card-body">
                    <form asp-action="Create" id="saleForm">
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                        <div class="form-group mb-3">
                            <label asp-for="CustomerName" class="control-label"></label>
                            <input asp-for="CustomerName" class="form-control" required />
                            <span asp-validation-for="CustomerName" class="text-danger"></span>
                        </div>

                        <div class="form-group mb-3">
                            <label asp-for="CustomerPhone" class="control-label"></label>
                            <input asp-for="CustomerPhone" class="form-control" required />
                            <span asp-validation-for="CustomerPhone" class="text-danger"></span>
                        </div>

                        <div class="form-group mb-3">
                            <label asp-for="PaymentMethod" class="control-label"></label>
                            <select asp-for="PaymentMethod" class="form-control" required>
                                <option value="">Select Payment Method</option>
                                <option value="Cash">Cash</option>
                                <option value="Credit Card">Credit Card</option>
                                <option value="Debit Card">Debit Card</option>
                                <option value="Bank Transfer">Bank Transfer</option>
                            </select>
                            <span asp-validation-for="PaymentMethod" class="text-danger"></span>
                        </div>

                        <div class="card mb-3">
                            <div class="card-header">
                                <h4 class="mb-0">Sale Items</h4>
                            </div>
                            <div class="card-body">
                                <div id="saleItems">
                                    <!-- Sale items will be added here -->
                                </div>
                                <button type="button" class="btn btn-success mt-3" id="addItem">
                                    <i class="fas fa-plus"></i> Add Item
                                </button>
                            </div>
                        </div>

                        <div class="form-group mb-3">
                            <label asp-for="Notes" class="control-label"></label>
                            <textarea asp-for="Notes" class="form-control" rows="3"></textarea>
                            <span asp-validation-for="Notes" class="text-danger"></span>
                        </div>

                        <div class="form-group">
                            <a asp-action="Index" class="btn btn-secondary">Back to List</a>
                            <button type="submit" class="btn btn-primary">Create Sale</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Template for sale item -->
<template id="saleItemTemplate">
    <div class="sale-item border rounded p-3 mb-2">
        <div class="row">
            <div class="col-md-5">
                <div class="form-group">
                    <label class="control-label">Product</label>
                    <select name="SaleItems[{index}].ProductId" class="form-control product-select" required>
                        <option value="">Select Product</option>
                        @foreach (var product in ViewBag.Products)
                        {
                            <option value="@product.ProductId" data-price="@product.SellingPrice">@product.Name - $@product.SellingPrice</option>
                        }
                    </select>
                </div>
            </div>
            <div class="col-md-3">
                <div class="form-group">
                    <label class="control-label">Quantity</label>
                    <input type="number" name="SaleItems[{index}].Quantity" class="form-control quantity-input" min="1" required />
                </div>
            </div>
            <div class="col-md-3">
                <div class="form-group">
                    <label class="control-label">Total</label>
                    <input type="text" class="form-control item-total" readonly />
                    <input type="hidden" name="SaleItems[{index}].UnitPrice" class="unit-price" />
                    <input type="hidden" name="SaleItems[{index}].TotalPrice" class="total-price" />
                </div>
            </div>
            <div class="col-md-1">
                <button type="button" class="btn btn-danger btn-sm mt-4 remove-item">
                    <i class="fas fa-trash"></i>
                </button>
            </div>
        </div>
    </div>
</template>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        $(document).ready(function () {
            let itemIndex = 0;

            // Add new item
            $('#addItem').click(function () {
                const template = document.getElementById('saleItemTemplate').innerHTML;
                const newItem = template.replace(/{index}/g, itemIndex++);
                $('#saleItems').append(newItem);
                updateTotals();
            });

            // Remove item
            $(document).on('click', '.remove-item', function () {
                $(this).closest('.sale-item').remove();
                updateTotals();
            });

            // Update totals when product or quantity changes
            $(document).on('change', '.product-select, .quantity-input', function () {
                const item = $(this).closest('.sale-item');
                const product = item.find('.product-select option:selected');
                const quantity = parseInt(item.find('.quantity-input').val()) || 0;
                const price = parseFloat(product.data('price')) || 0;

                const total = price * quantity;
                item.find('.unit-price').val(price);
                item.find('.total-price').val(total);
                item.find('.item-total').val('$' + total.toFixed(2));

                updateTotals();
            });

            // Add first item by default
            $('#addItem').click();

            // Form submission
            $('#saleForm').submit(function (e) {
                if ($('.sale-item').length === 0) {
                    e.preventDefault();
                    alert('Please add at least one item to the sale.');
                    return false;
                }
                return true;
            });
        });

        function updateTotals() {
            let grandTotal = 0;
            $('.total-price').each(function () {
                grandTotal += parseFloat($(this).val()) || 0;
            });
            // You can display the grand total if needed
            // $('#grandTotal').text('$' + grandTotal.toFixed(2));
        }
    </script>
} 