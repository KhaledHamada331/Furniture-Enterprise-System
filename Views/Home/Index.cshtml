@{
    ViewData["Title"] = "Home";
}

<div class="container">
    <div class="text-center mb-5">
        <h1 class="display-4">Welcome to El Assuity For Furniture</h1>
        <p class="lead">Please select your role to continue</p>
    </div>

    <div class="row justify-content-center">
        <!-- Admin Card -->
        <div class="col-md-4 mb-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body text-center">
                    <i class="bi bi-shield-lock display-4 mb-3 text-danger"></i>
                    <h3 class="card-title">Administrator</h3>
                    <p class="card-text">Manage the entire system</p>
                    <a href="@Url.Action("SelectRole", "Role", new { role = "Admin" })" class="btn btn-danger">Enter as Admin</a>
                </div>
            </div>
        </div>
        <!-- Accountant Card -->
        <div class="col-md-4 mb-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body text-center">
                    <i class="bi bi-calculator display-4 mb-3 text-success"></i>
                    <h3 class="card-title">Accountant</h3>
                    <p class="card-text">Manage financial records and reports</p>
                    <a href="@Url.Action("SelectRole", "Role", new { role = "Accountant" })" class="btn btn-success">Enter as Accountant</a>
                </div>
            </div>
        </div>
    </div>
    <div class="row justify-content-center">
        <!-- Inventory Manager Card -->
        <div class="col-md-6 mb-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body text-center">
                    <i class="bi bi-box display-4 mb-3 text-warning"></i>
                    <h3 class="card-title">Inventory Manager</h3>
                    <p class="card-text">Manage products and suppliers</p>
                    <a href="@Url.Action("SelectRole", "Role", new { role = "InventoryManager" })" class="btn btn-warning">Enter as Inventory Manager</a>
                </div>
            </div>
        </div>
        <!-- Sales Manager Card -->
        <div class="col-md-6 mb-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body text-center">
                    <i class="bi bi-graph-up display-4 mb-3 text-info"></i>
                    <h3 class="card-title">Sales Manager</h3>
                    <p class="card-text">Manage sales and customer orders</p>
                    <a href="@Url.Action("SelectRole", "Role", new { role = "SalesManager" })" class="btn btn-info">Enter as Sales Manager</a>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .card {
        transition: transform 0.2s;
    }
    .card:hover {
        transform: translateY(-5px);
    }
    .card-body {
        padding: 2rem;
    }
    .display-4 {
        font-size: 2.5rem;
        margin-bottom: 1rem;
    }
</style>
