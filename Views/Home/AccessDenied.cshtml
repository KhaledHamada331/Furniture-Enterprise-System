@{
    ViewData["Title"] = "Access Denied";
}

<div class="container py-5 text-center">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-sm border-0 p-5">
                <div class="mb-4">
                    <i class="bi bi-shield-slash text-danger display-1"></i>
                </div>
                <h1 class="h2 text-danger fw-bold mb-3">403 - Access Denied</h1>
                <p class="lead text-muted mb-4">
                    You do not have administrative privileges to access this page or resource.
                </p>
                <div class="d-flex justify-content-center gap-3">
                    <a asp-controller="Home" asp-action="Index" class="btn btn-primary px-4">
                        <i class="bi bi-house-door me-1"></i> Back to Home
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
