@model WebApplicationFES.Models.User
@{
    ViewData["Title"] = "User Details";
}
<div class="container py-4" style="max-width: 600px;">
    <h2 class="mb-4">User Details</h2>
    <div class="card p-4">
        <dl class="row">
            <dt class="col-sm-4">Username</dt>
            <dd class="col-sm-8">@Model.Username</dd>

            <dt class="col-sm-4">Email</dt>
            <dd class="col-sm-8">@Model.Email</dd>

            <dt class="col-sm-4">First Name</dt>
            <dd class="col-sm-8">@Model.FirstName</dd>

            <dt class="col-sm-4">Last Name</dt>
            <dd class="col-sm-8">@Model.LastName</dd>

            <dt class="col-sm-4">Role</dt>
            <dd class="col-sm-8">@Model.Role</dd>

            <dt class="col-sm-4">Active</dt>
            <dd class="col-sm-8">@(Model.IsActive ? "Yes" : "No")</dd>

            <dt class="col-sm-4">Created At</dt>
            <dd class="col-sm-8">@Model.CreatedAt.ToString("yyyy-MM-dd HH:mm")</dd>
        </dl>
        <a asp-action="Edit" asp-route-id="@Model.UserId" class="btn btn-warning me-2">
            <i class="bi bi-pencil"></i> Edit
        </a>
        <a asp-action="Index" class="btn btn-secondary">
            <i class="bi bi-arrow-left"></i> Back to List
        </a>
    </div>
</div> 