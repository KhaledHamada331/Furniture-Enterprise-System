@{
    ViewData["Title"] = "Portal Access";
}

@section Styles {
    <meta name="robots" content="noindex, nofollow" />
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-5 col-lg-4">
            <div class="card shadow border-0 rounded-3">
                <div class="card-body p-4 p-sm-5 text-center">
                    <div class="mb-4">
                        <i class="bi bi-shield-lock-fill text-danger display-4"></i>
                    </div>
                    <h3 class="card-title fw-bold mb-3">Portal Access</h3>
                    <p class="text-muted small mb-4">Please enter your authorized administrative credentials to proceed.</p>

                    <form method="post" asp-action="Login">
                        <div asp-validation-summary="All" class="text-danger small mb-3"></div>

                        <div class="form-floating mb-3 text-start">
                            <input type="password" name="password" class="form-control" id="adminPassword" placeholder="Password" required autofocus autocomplete="current-password" />
                            <label for="adminPassword">Admin Password</label>
                        </div>

                        <button class="btn btn-danger w-100 py-2 fw-semibold" type="submit">
                            <i class="bi bi-box-arrow-in-right me-1"></i> Sign In
                        </button>
                    </form>

                    <div class="mt-4">
                        <a asp-controller="Home" asp-action="Index" class="text-muted small text-decoration-none">
                            <i class="bi bi-arrow-left"></i> Return to Homepage
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
