@model WebApplicationFES.Models.Purchase

<div class="container mt-4">
    <h2>Delete Purchase</h2>
    <h4>Are you sure you want to delete this purchase?</h4>
    <dl class="row">
        <dt class="col-sm-2">Supplier</dt>
        <dd class="col-sm-10">@Model.Supplier?.CompanyName</dd>
        <dt class="col-sm-2">Purchase Date</dt>
        <dd class="col-sm-10">@Model.PurchaseDate.ToShortDateString()</dd>
        <dt class="col-sm-2">Total Amount</dt>
        <dd class="col-sm-10">@Model.TotalAmount</dd>
        <dt class="col-sm-2">Status</dt>
        <dd class="col-sm-10">@Model.Status</dd>
        <dt class="col-sm-2">Payment Method</dt>
        <dd class="col-sm-10">@Model.PaymentMethod</dd>
        <dt class="col-sm-2">Notes</dt>
        <dd class="col-sm-10">@Model.Notes</dd>
    </dl>
    <h4>Purchase Items</h4>
    <table class="table table-bordered">
        <thead>
            <tr>
                <th>Product</th>
                <th>Quantity</th>
                <th>Unit Price</th>
                <th>Total Price</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.PurchaseItems != null)
            {
                foreach (var item in Model.PurchaseItems)
                {
                    <tr>
                        <td>@item.Product?.Name</td>
                        <td>@item.Quantity</td>
                        <td>@item.UnitPrice</td>
                        <td>@item.TotalPrice</td>
                    </tr>
                }
            }
        </tbody>
    </table>
    <form asp-action="Delete">
        <input type="hidden" asp-for="PurchaseId" />
        <button type="submit" class="btn btn-danger">Delete</button>
        <a asp-action="Index" class="btn btn-secondary">Cancel</a>
    </form>
</div> 